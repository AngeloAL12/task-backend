# Copia este archivo como .env y rellena los valores reales.
# NUNCA commitees el .env con valores reales.

# Base de datos
DATABASE_URL=postgresql://user:password@localhost:5432/taskmaster_local

# Clave secreta para firmar JWT — genera con: openssl rand -hex 32
SECRET_KEY=reemplaza_con_clave_generada

# Tokens
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS — lista JSON de orígenes permitidos
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# APIs externas
GEMINI_API_KEY=tu_gemini_api_key
TELEGRAM_TOKEN=tu_telegram_bot_token
