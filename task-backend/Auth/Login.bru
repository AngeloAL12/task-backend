meta {
  name: Login
  type: http
  seq: 1
}

post {
  url: {{base_url}}/auth/token
  body: formUrlEncoded
  auth: inherit
}

body:form-urlencoded {
  username: angelo@fiono.tech
  password: password123
}

script:post-response {
  if (res.status === 200) {
      bru.setEnvVar("token", res.body.access_token);
      console.log("Token actualizado automáticamente! 🔓");
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
